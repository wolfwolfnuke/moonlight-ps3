# Build artifacts
*.o
*.elf
*.self
*.a

# Cross-built dependencies (regenerate via tools/build_ffmpeg.sh / BUILD.md).
# The build uses portlibs mbedTLS/libxml2; deps/ here is only vendored builds.
deps/

# Local toolchain/cache (native mbedTLS build, ffmpeg source, etc.)
.cache/

# PS3 package build output
pkg_build/
*.pkg

# pkgcrypt CPython extension build artifacts (rebuilt by `make pkg`)
tools/pkg/build/
tools/pkg/pkgcrypt*.so

# Editor / OS noise
*.swp
.DS_Store

# Python cache
__pycache__/
*.pyc
